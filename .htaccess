# Apache Production Performance Cache Headers
<IfModule mod_headers.c>
  # 1-year immutable caching for CSS & JS with version queries
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 30-day caching for static media assets
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|gif|ico|woff2|woff|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
